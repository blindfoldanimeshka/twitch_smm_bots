# .env.example - Пример конфигурации

# === Обязательные ===
API_KEY=your-secret-api-key-here

# Канал можно задавать через UI: Settings -> channels
# TWITCH_CHANNEL используется только как fallback (если в UI ничего не задано)
TWITCH_CHANNEL=

# === LLM Provider (выберите один вариант) ===

# Вариант 1: LM Studio (локально, бесплатно)
LLM_PROVIDER=lmstudio
LLM_API_URL=http://127.0.0.1:1234/v1
LLM_MODEL=local-model
# LLM_API_KEY не требуется

# Вариант 2: Omniroute (рекомендуется для production)
# LLM_PROVIDER=omniroute
# LLM_API_URL=https://omniroute.ai/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your-omniroute-api-key

# Вариант 3: OpenAI
# LLM_PROVIDER=openai
# LLM_API_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-your-openai-key

# === Опциональные (есть defaults) ===
DATABASE_URL=postgres://botfarm:botfarm@localhost:5432/twitch_bot_farm?sslmode=disable
REDIS_URL=redis://localhost:6379
API_PORT=8080
API_CORS_ORIGINS=http://localhost:5173
ENABLE_CONSOLE=true

# === Локальная транскрипция стрима (опционально) ===
# Включается через UI флаг `audio_enabled`
# Нужны установленные streamlink + ffmpeg
AUDIO_STT_URL=http://localhost:9000/v1/audio/transcriptions
AUDIO_STT_MODEL=whisper-1
AUDIO_STT_API_KEY=
AUDIO_STT_LANGUAGE=ru
AUDIO_CHUNK_SEC=8
AUDIO_POLL_SEC=15
AUDIO_CONTEXT_TTL_SEC=120
AUDIO_CONTEXT_MAX_CHARS=320
AUDIO_STREAM_QUALITY=best
AUDIO_STREAMLINK_CMD=streamlink
AUDIO_FFMPEG_CMD=ffmpeg
# Если хотите прямой источник вместо Twitch+streamlink:
# AUDIO_SOURCE_URL=https://example.com/live.m3u8

# === Настройки локального STT контейнера (docker-compose service: stt) ===
STT_MODEL_NAME=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
