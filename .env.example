# .env.example - Пример конфигурации

# === Обязательные ===
TWITCH_CHANNEL=your_channel_name
API_KEY=your-secret-api-key-here

# === LLM Provider (выберите один вариант) ===

# Вариант 1: LM Studio (локально, бесплатно)
LLM_PROVIDER=lmstudio
LLM_API_URL=http://127.0.0.1:1234/v1
LLM_MODEL=local-model
# LLM_API_KEY не требуется

# Вариант 2: Omniroute (рекомендуется для production)
# LLM_PROVIDER=omniroute
# LLM_API_URL=https://omniroute.ai/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your-omniroute-api-key

# Вариант 3: OpenAI
# LLM_PROVIDER=openai
# LLM_API_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=sk-your-openai-key

# === Опциональные (есть defaults) ===
DATABASE_URL=postgres://botfarm:botfarm@localhost:5432/twitch_bot_farm?sslmode=disable
REDIS_URL=redis://localhost:6379
API_PORT=8080
API_CORS_ORIGINS=http://localhost:5173
ENABLE_CONSOLE=true
