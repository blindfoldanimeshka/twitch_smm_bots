# .env.example - Пример конфигурации
# Файл .env НЕ обязателен: docker-compose.yml содержит рабочие значения по умолчанию.
# Скопируйте этот файл в .env, только если хотите что-то изменить.

# === Обязательные ===
API_KEY=your-secret-api-key-here

# Docker image mirror (for regions where Docker Hub is blocked)
# For Russia/CIS: mirror.yandex.ru/mirrors/docker/library/
# Leave empty if Docker Hub works normally
BASE_IMAGE_PREFIX=

# Канал можно задавать через UI: Settings -> channels
# TWITCH_CHANNEL используется только как fallback (если в UI ничего не задано)
TWITCH_CHANNEL=

# === Шифрование refresh-токенов ботов ===
# Ключ (base64, ровно 32 байта) для AES-256-GCM шифрования refresh-токенов,
# импортируемых через UI (Bots -> импорт токена). Сгенерировать:
#   openssl rand -base64 32
# Без ключа импорт refresh-токена отклоняется (503); импорт только
# access-токена работает. Никогда не коммитьте реальное значение.
TOKEN_ENCRYPTION_KEY=

# === LLM (OpenRouter) ===
# Ключ: https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Устаревшее имя; используется только если OPENROUTER_API_KEY и ключ в БД пусты
LLM_API_KEY=
LLM_PROVIDER=openrouter
LLM_API_URL=https://openrouter.ai/api/v1
# Бесплатная модель-роутер: сам выбирает доступную бесплатную модель
LLM_MODEL=openrouter/free
# Платная модель на случай, если бесплатная недоступна/исчерпана
LLM_PAID_MODEL=z-ai/glm-5.3-flash
# Необязательные операторские переопределения. Если закомментированы,
# используются значения из UI/базы данных.
# LLM_PAID_ENABLED=false
# LLM_PAID_DAILY_CAP_USD=1.0
OPENROUTER_REFERER=http://localhost:3000
OPENROUTER_TITLE=Twitch SMM Bot Farm

# === Опциональные (есть defaults) ===
DATABASE_URL=postgres://botfarm:botfarm@localhost:5432/botfarm?sslmode=disable
REDIS_URL=redis://localhost:6379
API_PORT=8080
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
ENABLE_CONSOLE=true

# === Локальная транскрипция стрима (опционально) ===
# Включается через UI флаг `audio_enabled`.
# Требует профиль audio и файл models/ggml-small-q5_1.bin:
#   docker compose --profile audio up -d
AUDIO_STT_URL=http://stt:9000/v1/audio/transcriptions
AUDIO_STT_MODEL=whisper-1
AUDIO_STT_API_KEY=
AUDIO_STT_LANGUAGE=ru
AUDIO_CHUNK_SEC=8
AUDIO_POLL_SEC=15
AUDIO_CONTEXT_TTL_SEC=120
AUDIO_CONTEXT_MAX_CHARS=320
AUDIO_STREAM_QUALITY=best
AUDIO_STREAMLINK_CMD=streamlink
AUDIO_FFMPEG_CMD=ffmpeg
# Если хотите прямой источник вместо Twitch+streamlink:
# AUDIO_SOURCE_URL=https://example.com/live.m3u8

# === Настройки контейнера whisper.cpp (docker-compose service: stt) ===
STT_MODEL_FILE=ggml-small-q5_1.bin
STT_THREADS=4
STT_LANGUAGE=ru

# === Временная почта (TempFastMail, отдельный контейнер) ===
# Публичный образ kasteckis/tempfastmail (GPL-3.0) запускается без изменений.
# Подробности и подключение входящей почты: docs/TEMPORARY_MAIL.md
TEMPFASTMAIL_URI=http://localhost:8090
# По умолчанию биндим только на loopback; наружу — через Cloudflare Tunnel/TLS-прокси
TEMPFASTMAIL_BIND=127.0.0.1
TEMPFASTMAIL_PORT=8090
# Секрет приложения: сгенерировать `openssl rand -hex 32`, не коммитить
TEMPFASTMAIL_APP_SECRET=
# Ключ, которым Cloudflare Worker авторизуется при доставке писем
TEMPFASTMAIL_API_KEY=
# Хранение писем и ящиков, часов (автоочистка)
TEMPFASTMAIL_RETENTION_HOURS=48
# URL сервиса почт, который видит фронтенд (соберётся в бандл)
VITE_TEMP_MAIL_URL=http://localhost:8090
